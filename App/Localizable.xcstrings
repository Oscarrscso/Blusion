    "Blusion includes no content or stream sources. Cinemeta provides catalogs and search; you can remove it in Settings › Addons. Blusion isn’t affiliated with any addon or service.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blusion includes no content or stream sources. Cinemeta provides catalogs and search; you can remove it in Settings › Addons. Blusion isn’t affiliated with any addon or service."
          }
        }
      }
    },
    "Blusion is a player for content you have the right to watch. It includes no content and no addons, and it isn't affiliated with any addon or service.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blusion is a player for content you have the right to watch. It includes no content and no addons, and it isn't affiliated with any addon or service."
          }
        }
      }
    },
