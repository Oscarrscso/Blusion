    "Enter your own API Client ID and Client Secret. Credentials and sign-in tokens are stored in the Keychain. A Client ID alone also enables public Trakt list widgets.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your own API Client ID and Client Secret. Credentials and sign-in tokens are stored in the Keychain. A Client ID alone also enables public Trakt list widgets."
          }
        }
      }
    },
    "Enter your own API Client ID and Client Secret. Set your API app’s Redirect URI to urn:ietf:wg:oauth:2.0:oob so token refresh works. Credentials and sign-in tokens are stored in the Keychain. A Client ID alone also enables public Trakt list widgets.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your own API Client ID and Client Secret. Set your API app’s Redirect URI to urn:ietf:wg:oauth:2.0:oob so token refresh works. Credentials and sign-in tokens are stored in the Keychain. A Client ID alone also enables public Trakt list widgets."
          }
        }
      }
    },
